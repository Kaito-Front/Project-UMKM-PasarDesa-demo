{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://umkmdesa.smkn1sumedang.sch.id/api/:path*"
    },
    {
      "source": "/storage/:path*",
